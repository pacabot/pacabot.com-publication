Options -Indexes
ErrorDocument 404 /404.html

# Le dossier servi est un clone Git (déploiement Git OVH, dépôt pacabot.com-publication) :
# fichiers et dossiers cachés (.git, .gitignore…) jamais servis, sauf /.well-known/ (certificats).
RedirectMatch 404 "/\.(?!well-known/)"

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire. OVH : la détection fiable du HTTP clair passe par le port.
  # /.well-known/ reste accessible pour la validation du certificat Let's Encrypt.
  RewriteCond %{SERVER_PORT} ^80$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # www.pacabot.com → pacabot.com
  RewriteCond %{HTTP_HOST} ^www\.pacabot\.com$ [NC]
  RewriteRule ^ https://pacabot.com%{REQUEST_URI} [R=301,L]
</IfModule>

# Anciennes adresses du site Drupal (2010-2019)
# Articles → actualités
RedirectMatch 301 ^/(node/4|zhonx3_presentation)(\.html)?/?$ https://pacabot.com/actualites/2012-11-29-le-defi-zhonx-iii/
RedirectMatch 301 ^/(node/12|Zhoe1_presentation)(\.html)?/?$ https://pacabot.com/actualites/2014-06-28-zhoe-i/
RedirectMatch 301 ^/node/13(\.html)?/?$ https://pacabot.com/actualites/2010-02-17-four-a-refusion/
RedirectMatch 301 ^/node/14(\.html)?/?$ https://pacabot.com/actualites/2014-06-30-new-sponsor/
RedirectMatch 301 ^/node/21(\.html)?/?$ https://pacabot.com/actualites/2014-07-05-nos-sponsors/
RedirectMatch 301 ^/(node/22|aimantationbase)(\.html)?/?$ https://pacabot.com/actualites/2014-07-12-zhonx-iii-test-aimantation-base/
RedirectMatch 301 ^/(node/23|zhonx2_presentation)(\.html)?/?$ https://pacabot.com/actualites/2014-07-16-zhonx-ii-presentation/
RedirectMatch 301 ^/node/(8|26|29)(\.html)?/?$ https://pacabot.com/actualites/2014-12-05-24h-sur-la-terre/
RedirectMatch 301 ^/node/27(\.html)?/?$ https://pacabot.com/actualites/2015-01-27-code-source-de-zhonx-iii/
RedirectMatch 301 ^/node/30(\.html)?/?$ https://pacabot.com/actualites/2015-02-23-zhonx-iii-ca-roule/
RedirectMatch 301 ^/node/31(\.html)?/?$ https://pacabot.com/actualites/2014-11-15-le-labyrinthe-l-aire-de-jeux/
RedirectMatch 301 ^/node/32(\.html)?/?$ https://pacabot.com/actualites/2015-02-23-bluetooth/
RedirectMatch 301 ^/node/34(\.html)?/?$ https://pacabot.com/actualites/2015-10-20-migration-du-code-source/
RedirectMatch 301 ^/node/35(\.html)?/?$ https://pacabot.com/actualites/2015-11-22-made-in-friche-machines/
RedirectMatch 301 ^/(node/36|tournoi_nimes_2016)(\.html)?/?$ https://pacabot.com/actualites/2016-05-09-tournoi-national-de-robotique-nimes-2016/
RedirectMatch 301 ^/node/37(\.html)?/?$ https://pacabot.com/actualites/2016-05-23-nimes-2016-c-est-gagne/
RedirectMatch 301 ^/node/40(\.html)?/?$ https://pacabot.com/actualites/2016-11-12-zhonx-iv-maquette-v0-2-17/
RedirectMatch 301 ^/node/41(\.html)?/?$ https://pacabot.com/actualites/2016-11-13-le-defi-zhonx-iv/
RedirectMatch 301 ^/node/42(\.html)?/?$ https://pacabot.com/actualites/2016-11-13-calibration-des-telemetres/
RedirectMatch 301 ^/node/43(\.html)?/?$ https://pacabot.com/actualites/2016-11-27-tenon-mortaise/
RedirectMatch 301 ^/node/44(\.html)?/?$ https://pacabot.com/actualites/2016-12-10-zhonx-iv-maquette-v0-2-18/
RedirectMatch 301 ^/node/45(\.html)?/?$ https://pacabot.com/actualites/2019-01-09-pacabot-junior/
# Pages → nouvelles rubriques
RedirectMatch 301 ^/(zhonx-iii)(\.html)?/?$ https://pacabot.com/projets/zhonx-3/
RedirectMatch 301 ^/(zhonx-ii)(\.html)?/?$ https://pacabot.com/projets/zhonx-2/
RedirectMatch 301 ^/(zhonx-iv)(\.html)?/?$ https://pacabot.com/projets/zhonx-4/
RedirectMatch 301 ^/(zhoe)(\.html)?/?$ https://pacabot.com/projets/zhoe-1/
RedirectMatch 301 ^/(four_a_refusion)(\.html)?/?$ https://pacabot.com/projets/four-a-refusion/
RedirectMatch 301 ^/(projects|outils)(\.html)?/?$ https://pacabot.com/projets/
RedirectMatch 301 ^/evenements(\.html)?/?$ https://pacabot.com/actualites/
RedirectMatch 301 ^/sponsors(\.html)?/?$ https://pacabot.com/club/#partenaires
RedirectMatch 301 ^/(node/7|club\.html)/?$ https://pacabot.com/club/
RedirectMatch 301 ^/(contact|user|user/.*|rss\.xml|taxonomy/.*)$ https://pacabot.com/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  # Fichiers générés par Astro : nom haché, donc cache permanent
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
